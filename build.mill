//| mvnDeps:
//| - com.goyeau::mill-scalafix::0.6.2
//| - com.github.lolgab::mill-mima::0.2.2

package build

import mill.*
import mill.scalalib.*
import mill.scalalib.publish.*
import mill.scalalib.scalafmt.*
import mill.scalajslib.*

import com.github.lolgab.mill.mima.Mima
import com.goyeau.mill.scalafix.ScalafixModule

// ---------------------------------------------------------------------------
// Version catalog
// ---------------------------------------------------------------------------
object V {
  val scala         = "3.9.0"
  val scalaJS       = "1.22.0"
  val zio           = "2.1.27"
  val zioJson       = "1.1.1"
  val scalaJavaTime = "2.8.0"
}

// ---------------------------------------------------------------------------
// Version from git: an exact v-tag on a clean tree is the release, anything else
// a SNAPSHOT of the last tag. Untracked files do not count. A Task.Input, so a
// new commit, tag or edit is seen without restarting the Mill daemon. The
// release itself is the Makefile's (release-prepare / release-finalize).
// ---------------------------------------------------------------------------
object release extends Module {
  def gitVersion = Task.Input {
    val root     = os.Path(sys.env("MILL_WORKSPACE_ROOT"))
    def git(args: String*) = os.proc("git", args).call(cwd = root, check = false)
    val tag      = git("describe", "--tags", "--abbrev=0", "--match", "v[0-9]*")
    val version  = if (tag.exitCode == 0) tag.out.trim().stripPrefix("v") else "0.0.0"
    val exactTag = git("describe", "--tags", "--exact-match", "--match", "v[0-9]*").exitCode == 0
    val clean    = git("status", "--porcelain").out.text().linesIterator.forall(_.startsWith("??"))
    if (exactTag && clean) version else s"$version-SNAPSHOT"
  }

  // The first release under dev.taihei. Older tags are genius-i18n and edo-i18n, under other
  // coordinates, so there is nothing on Central to compare them with.
  val firstRelease = "4.0.0"

  // The first release of the major line main is on. MiMa compares only within a major line: a
  // major may break, so a release of the previous major is no baseline for it. Raise this when
  // work on the next major starts on main; release-prepare TYPE=major still sets none.
  val majorLine = "5.0.0"

  // The release MiMa compares with: the newest v-tag reachable from HEAD and not on HEAD itself,
  // none before firstRelease or majorLine. On a tagged release commit that is the release before it: HEAD's
  // own tag would compare the release with itself, and fails in CI until Central has synced it.
  // MIMA_BASELINE overrides it: `none` for a major, which may break (release-prepare TYPE=major
  // sets it), or a version.
  def mimaBaseline = Task.Input {
    val root = os.Path(sys.env("MILL_WORKSPACE_ROOT"))
    def numbers(v: String) = v.split('.').toSeq.map(_.toIntOption.getOrElse(0))
    def git(args: String*) = os.proc("git", args).call(cwd = root, check = false)
    Task.env.get("MIMA_BASELINE").map(_.trim).filter(_.nonEmpty) match {
      case Some("none") => None
      case Some(v)      => Some(v)
      case None         =>
        val exactTag = git("describe", "--tags", "--exact-match", "--match", "v[0-9]*").exitCode == 0
        // A root commit has no HEAD^, so describe fails and there is no baseline.
        val tag = git("describe", "--tags", "--abbrev=0", "--match", "v[0-9]*", if (exactTag) "HEAD^" else "HEAD")
        Option
          .when(tag.exitCode == 0)(tag.out.trim().stripPrefix("v"))
          .filter(v => Ordering.Implicits.seqOrdering[Seq, Int].gteq(numbers(v), numbers(firstRelease)))
          .filter(v => Ordering.Implicits.seqOrdering[Seq, Int].gteq(numbers(v), numbers(majorLine)))
    }
  }
}

// ---------------------------------------------------------------------------
// Binary compatibility: MiMa compares the artifact with the baseline release on Central and
// fails on a break (`make mima`, part of validate). No baseline, nothing to compare.
// ---------------------------------------------------------------------------
trait TaiheiMima extends Mima with PublishModule {
  def mimaPreviousVersions = Task(release.mimaBaseline().toSeq)
  // The plugin's default fails without a version; no baseline here means nothing to compare.
  def mimaPreviousArtifacts = Task {
    mimaPreviousVersions().map(v => mvn"${pomSettings().organization}:${artifactId()}:$v")
  }
}

// ---------------------------------------------------------------------------
// Shared publishing settings for JVM and JS modules: what Maven Central
// validates (name, description, url, licence, developer, scm, sources, docs).
// ---------------------------------------------------------------------------
trait TaiheiPublishSettings extends PublishModule {
  def publishVersion = release.gitVersion()

  def pomSettings = PomSettings(
    description = "Composable, type-safe i18n for Scala 3 — locales, messages, ICU-style formatting; JVM & JS",
    organization = "dev.taihei",
    url = "https://github.com/taiheiframework/i18n",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("taiheiframework", "i18n"),
    developers = Seq(
      Developer("innovenso", "Innovenso BV", "https://taihei.dev", Some("Innovenso BV"), Some("https://innovenso.com")),
    ),
  )
}

// Silences the deprecation of dev.taihei.i18n.legacy, which its tests use on purpose.
val LegacyInTests = Seq("-Wconf:cat=deprecation&origin=dev\\.taihei\\.i18n\\.legacy\\..*:s")

// ---------------------------------------------------------------------------
// Base trait for JVM modules
// ---------------------------------------------------------------------------
trait TaiheiModule extends ScalaModule with ScalafmtModule with ScalafixModule with TaiheiPublishSettings with TaiheiMima {
  def scalaVersion = V.scala

  def scalacOptions = Seq(
    "-Wunused:all",
    "-unchecked",
    "-deprecation",
    "-feature",
    "-Xmax-inlines:128",
    // The message macro expands in user code: what it calls must be public in the bytecode.
    "-WunstableInlineAccessors",
    "-Wconf:msg=Unstable inline accessor:e",
  )

  trait TaiheiTests extends ScalaTests with ScalafmtModule with ScalafixModule {
    def testFramework = "zio.test.sbt.ZTestFramework"

    // The tests of legacy.Message use it on purpose.
    def scalacOptions = Task { super.scalacOptions() ++ LegacyInTests }

    def forkArgs = Seq(
      "-Xmx4G",
      "-Xms2G",
      "-Xss16M",
      "-XX:+UseG1GC",
      "-XX:MaxGCPauseMillis=200",
    )

    def mvnDeps = Seq(
      mvn"dev.zio::zio-test:${V.zio}",
      mvn"dev.zio::zio-test-sbt:${V.zio}",
    )
  }
}

// ---------------------------------------------------------------------------
// Base trait for Scala.js modules
// ---------------------------------------------------------------------------
trait TaiheiJSModule extends ScalaJSModule with ScalafmtModule with ScalafixModule with TaiheiPublishSettings with TaiheiMima {
  def scalaVersion   = V.scala
  def scalaJSVersion = V.scalaJS

  def scalacOptions = Seq(
    "-Wunused:all",
    "-unchecked",
    "-deprecation",
    "-feature",
    "-Xmax-inlines:128",
    // The message macro expands in user code: what it calls must be public in the bytecode.
    "-WunstableInlineAccessors",
    "-Wconf:msg=Unstable inline accessor:e",
  )

  // java.time on Scala.js is provided by scala-java-time (+ tzdb for zone data).
  def jsDeps = Seq(
    mvn"io.github.cquiroz::scala-java-time::${V.scalaJavaTime}",
    mvn"io.github.cquiroz::scala-java-time-tzdb::${V.scalaJavaTime}",
  )

  trait TaiheiJSTests extends ScalaJSTests with ScalafmtModule with ScalafixModule {
    def testFramework = "zio.test.sbt.ZTestFramework"

    // The tests of legacy.Message use it on purpose.
    def scalacOptions = Task { super.scalacOptions() ++ LegacyInTests }

    def mvnDeps = Seq(
      mvn"dev.zio::zio-test::${V.zio}",
      mvn"dev.zio::zio-test-sbt::${V.zio}",
    )
  }
}

// ---------------------------------------------------------------------------
// Workspace root for resolving cross-platform source paths
// ---------------------------------------------------------------------------
val wsRoot = os.Path(sys.env("MILL_WORKSPACE_ROOT"))

// ---------------------------------------------------------------------------
// Module: i18n (cross-platform JVM + JS)
//   shared sources compile on both platforms; jvm/ and js/ hold the
//   platform-specific number/date formatters.
// ---------------------------------------------------------------------------
object i18n extends Module {
  object jvm extends TaiheiModule {
    def artifactName = "taihei-i18n"

    def sources = Task.Sources(
      wsRoot / "shared" / "src",
      wsRoot / "jvm" / "src",
    )

    def mvnDeps = Seq(
      mvn"dev.zio::zio-json:${V.zioJson}",
    )

    // The catalogue files of CoreMessages, read from the classpath. Scala.js has no classpath:
    // a browser application serves the files that taihei-i18n-tools exports.
    def resources = Task.Sources(
      wsRoot / "shared" / "resources",
    )

    object test extends TaiheiTests {
      def sources = Task.Sources(
        wsRoot / "shared" / "test" / "src",
        wsRoot / "jvm" / "test" / "src",
      )

      def resources = Task.Sources(
        wsRoot / "jvm" / "test" / "resources",
      )
    }
  }

  object js extends TaiheiJSModule {
    def artifactName = "taihei-i18n"

    def sources = Task.Sources(
      wsRoot / "shared" / "src",
      wsRoot / "js" / "src",
    )

    def mvnDeps = Seq(
      mvn"dev.zio::zio-json::${V.zioJson}",
    ) ++ jsDeps

    object test extends TaiheiJSTests {
      def sources = Task.Sources(
        wsRoot / "shared" / "test" / "src",
        wsRoot / "js" / "test" / "src",
      )
    }
  }

  // ---------------------------------------------------------------------------
  // taihei-i18n-tools: the JVM-only program that exports catalogues. JVM only because its whole
  // job is writing files.
  // ---------------------------------------------------------------------------
  object tools extends TaiheiModule {
    def artifactName = "taihei-i18n-tools"

    def pomSettings = Task {
      super.pomSettings().copy(description = "Exports the message catalogues of taihei-i18n families to per-language JSON files; JVM")
    }

    def moduleDeps = Seq(i18n.jvm)

    def sources = Task.Sources(
      wsRoot / "tools" / "src",
    )

    object test extends TaiheiTests {
      def sources = Task.Sources(
        wsRoot / "tools" / "test" / "src",
      )
    }
  }
}
